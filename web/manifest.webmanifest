{
  "name": "TOTO & 4D Check",
  "short_name": "TOTO Check",
  "description": "Check a Singapore TOTO or 4D ticket against the official result. Not affiliated with Singapore Pools.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0D0A1E",
  "theme_color": "#0D0A1E",
  "categories": ["utilities"],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {"files": [{"name": "screenshots", "accept": ["image/png", "image/jpeg", "image/webp"]}]}
  },
  "icons": [
    {"src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ]
}
